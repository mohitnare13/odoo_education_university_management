<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="notice_board_email_template" model="mail.template">
        <field name="name">Notice Board Notification</field>
        <field name="model_id" ref="education_university_management.model_university_notice"/>
        <field name="subject">Notice Board Update - {{object.subject}}</field>
        <field name="email_from">${(object.create_uid.email) </field>

        <field name="body_html" type="html">
            <p>Dear Student,</p>
            <p>Please check the updated notice:</p>
            <h3>${object.subject}</h3>
            <p>${object.description}</p>
            <p>Regards,<br/>University Admin</p>
        </field>
    </record>
</odoo>
